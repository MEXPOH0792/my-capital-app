<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/voice_capture_panel">

        <ImageView
            android:id="@+id/voice_capture_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="18dp"
            android:background="@drawable/widget_button_voice"
            android:contentDescription="@string/widget_voice_expense"
            android:src="@drawable/ic_widget_mic"/>

        <TextView
            android:id="@+id/voice_capture_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Слушаю…"
            android:textColor="#E6F2EB"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/voice_capture_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Назови категорию, сумму и счёт"
            android:textColor="#9FC3A9"
            android:textSize="13sp"/>
    </LinearLayout>
</FrameLayout>
